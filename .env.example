# PostgreSQL connection string for the storefront database
DATABASE_URL=postgresql://user:password@localhost:5432/part_seo_engine

# eBay Partner Network campaign ID — appended as campid= to every outbound eBay link
NEXT_PUBLIC_EPN_CAMP_ID=1234567890

# Public origin of this site (sitemap, canonical tags, JSON-LD). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com
